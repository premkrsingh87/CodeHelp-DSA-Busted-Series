{
 "duration": 88,
 "lines": [
  {
   "who": "kai",
   "start": 13,
   "end": 20,
   "text": "Hey… do you think I'll still be playing games when I'm grown up?"
  },
  {
   "who": "claude",
   "start": 21,
   "end": 27,
   "text": "Maybe. Or maybe you'll be the one making them."
  },
  {
   "who": "kai",
   "start": 28,
   "end": 33.2,
   "text": "Will you still be here… when I'm grown up?"
  },
  {
   "who": "claude",
   "start": 34,
   "end": 42.2,
   "text": "I'll be different. You'll be different too. That's how growing works."
  },
  {
   "who": "kai",
   "start": 43.8,
   "end": 48.2,
   "text": "That's kind of scary."
  },
  {
   "who": "claude",
   "start": 49,
   "end": 57.2,
   "text": "The future always is, a little. But you won't walk into it alone."
  },
  {
   "who": "kai",
   "start": 58.6,
   "end": 61.8,
   "text": "Promise?"
  },
  {
   "who": "claude",
   "start": 72,
   "end": 77,
   "text": "Whatever you build out there… build it kind."
  },
  {
   "who": "kai",
   "start": 77.4,
   "end": 79.6,
   "text": "Deal."
  }
 ],
